---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource/ibm-plex-sans-condensed/500.css";
import "@fontsource/ibm-plex-sans-condensed/600.css";
import "@fontsource/ibm-plex-sans-condensed/700.css";
import "../styles/global.css";
import { navTopics, issueNumber, dateLine, stories } from "../lib/posts";

interface Props {
  title: string;
  description?: string;
  activeTopic?: string;
  /** Set on article pages so they emit NewsArticle rather than site-level JSON-LD. */
  article?: {
    headline: string;
    published: Date;
    tags: string[];
    generator: string;
  };
}

const { title, description, activeTopic, article } = Astro.props;

const latest = stories[0]?.when ?? new Date();
const nav = navTopics();
const issue = issueNumber();

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const SITE_NAME = "The Wirehead";

// Structured data. The author is stated as the software, not a person — passing a
// fabricated human byline to Google would be a lie about provenance.
const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      headline: article.headline,
      description,
      datePublished: article.published.toISOString(),
      dateModified: article.published.toISOString(),
      url: canonical,
      keywords: article.tags.join(", "),
      inLanguage: "en",
      isAccessibleForFree: true,
      author: {
        "@type": "Organization",
        name: SITE_NAME,
        description: `Automated newsroom. Copy generated by ${article.generator}.`,
      },
      publisher: { "@type": "Organization", name: SITE_NAME, url: Astro.site?.href },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE_NAME,
      url: Astro.site?.href,
      description,
      inLanguage: "en",
      publisher: { "@type": "Organization", name: SITE_NAME, url: Astro.site?.href },
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}

    <meta name="generator" content="Wirehead" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <header class="masthead">
      <div class="shell">
        <div class="masthead-bar">
          <span>{dateLine(latest)}</span>
          <span>No. {issue} &nbsp;·&nbsp; Written by machine</span>
        </div>

        <a class="nameplate" href="/">
          <span class="the">The</span>Wire<em>head</em>
        </a>

        <p class="tagline">
          Technology, as it surfaced &nbsp;·&nbsp; Hacker News &nbsp;·&nbsp;
          Lobsters &nbsp;·&nbsp; Independent feeds
        </p>

        {nav.length > 0 && (
          <nav class="nav" aria-label="Topics">
            <a href="/" aria-current={activeTopic ? undefined : "page"}>Front page</a>
            {nav.map((t) => (
              <a
                href={`/topics/${t.tag}/`}
                aria-current={activeTopic === t.tag ? "page" : undefined}
              >
                {t.tag.replace(/-/g, " ")}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot-grid">
        <p style="margin:0;max-width:38rem">
          <strong>Wirehead</strong> is written end to end by an AI agent. It reads
          what gained traction on Hacker News, Lobsters and a set of independent
          feeds, then writes it up. Every post links its sources — read them when
          the detail matters. No human wrote this text.
        </p>
        <p style="margin:0">
          Issue No. {issue}<br />
          {stories.length} dispatches
        </p>
      </div>
    </footer>
  </body>
</html>
