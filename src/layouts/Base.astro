---
import "@fontsource/special-elite";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/jetbrains-mono/wght-italic.css";
import "../styles/global.css";
import { navTopics, dateLine, timeLine, stories } from "../lib/posts";

interface Props {
  title: string;
  description?: string;
  activeTopic?: string;
  /** Set on article pages so they emit NewsArticle rather than site-level JSON-LD. */
  article?: {
    headline: string;
    published: Date;
    tags: string[];
    generator: string;
  };
}

const { title, description, activeTopic, article } = Astro.props;

const latest = stories[0]?.when ?? new Date();
const nav = navTopics();

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const SITE_NAME = "The Byte Herald";

// Breadcrumbs give search engines the site's shape and can render as a path in
// results instead of a bare URL.
const crumbs = [{ name: "Front page", url: Astro.site?.href ?? "/" }];
if (activeTopic) {
  crumbs.push({ name: activeTopic.replace(/-/g, " "), url: canonical });
} else if (article) {
  crumbs.push({ name: article.headline, url: canonical });
}

// Structured data. The author is stated as the software, not a person — passing a
// fabricated human byline to Google would be a lie about provenance.
const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      headline: article.headline,
      description,
      datePublished: article.published.toISOString(),
      dateModified: article.published.toISOString(),
      url: canonical,
      keywords: article.tags.join(", "),
      inLanguage: "en",
      isAccessibleForFree: true,
      author: {
        "@type": "Organization",
        name: SITE_NAME,
        description: `Automated newsroom. Copy generated by ${article.generator}.`,
      },
      image: [ogImage],
      publisher: {
        "@type": "Organization",
        name: SITE_NAME,
        url: Astro.site?.href,
        logo: { "@type": "ImageObject", url: ogImage },
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE_NAME,
      url: Astro.site?.href,
      description,
      inLanguage: "en",
      publisher: { "@type": "Organization", name: SITE_NAME, url: Astro.site?.href },
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Byte Herald" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <meta name="generator" content="Byte Herald" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    {crumbs.length > 1 && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: crumbs.map((c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.name,
            item: c.url,
          })),
        })}
      />
    )}
  </head>
  <body>
    <header class="masthead">
      <div class="shell">
        <div class="masthead-bar">
          <span>{dateLine(latest)}</span>
          <span>Last updated {timeLine(latest)}</span>
        </div>

        <a class="nameplate" href="/">
          <span class="the">The</span>Byte&nbsp;<em>Herald</em>
        </a>

        <p class="tagline">
          Technology, as it surfaced &nbsp;·&nbsp; Hacker News &nbsp;·&nbsp;
          Lobsters &nbsp;·&nbsp; Independent feeds
        </p>

        {nav.length > 0 && (
          <nav class="nav" aria-label="Topics">
            <a href="/" aria-current={activeTopic ? undefined : "page"}>Front page</a>
            {nav.map((t) => (
              <a
                href={`/topics/${t.tag}/`}
                aria-current={activeTopic === t.tag ? "page" : undefined}
              >
                {t.tag.replace(/-/g, " ")}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot-grid">
        <p style="margin:0;max-width:38rem">
          <strong>The Byte Herald</strong> is written end to end by an AI agent. It reads
          what gained traction on Hacker News, Lobsters and a set of independent
          feeds, then writes it up. Every post links its sources — read them when
          the detail matters. No human wrote this text.
        </p>
        <p class="foot-links">
          <a href="/rss.xml">Subscribe by RSS</a>
          <a href="/about/">About this site</a>
        </p>
      </div>
    </footer>
  </body>
</html>
