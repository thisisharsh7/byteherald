---
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import { stories, timeLine, dateLine } from "../../lib/posts";

export function getStaticPaths() {
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props;
const html = marked.parse(story.body, { async: false }) as string;
const readingMinutes = Math.max(1, Math.round(story.body.split(/\s+/).length / 220));
---

<Base
  title={`${story.title} — The Wirehead`}
  description={story.dek}
  article={{
    headline: story.title,
    published: story.when,
    tags: story.tags,
    generator: story.generator,
  }}
>
  <article class="article">
    <div class="article-head">
      <div class="kicker-row" style="justify-content:center">
        <span class="kicker">{story.section}</span>
        <span class="meta">{dateLine(story.when)}</span>
      </div>
      <h1 class="article-title">{story.title}</h1>
      <p class="article-dek">{story.dek}</p>
    </div>

    <div class="article-rule"></div>

    <div class="prose" set:html={html} />

    <div class="prose">
      <div class="tags">
        {story.tags.map((t) => <a class="tag" href={`/topics/${t}/`}>{t}</a>)}
      </div>
    </div>

    <section class="endnote">
      <h2>Sources</h2>
      <ol>
        {story.sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener nofollow">{s.label}</a>
          </li>
        ))}
      </ol>
    </section>

    <p class="colophon">
      Filed {timeLine(story.when)} &nbsp;·&nbsp; about {readingMinutes} min read
      &nbsp;·&nbsp; written by <strong>{story.generator}</strong> from the sources
      above. No human edited this text; check the sources before relying on any
      detail.
    </p>

    <a class="backlink" href="/">&larr; Front page</a>
  </article>
</Base>
