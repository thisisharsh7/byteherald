---
import Base from "../layouts/Base.astro";
import { frontPage, timeLine } from "../lib/posts";

const { lead, rest } = frontPage();
const rail = rest.slice(0, 4);
const grid = rest.slice(4);
---

<Base
  title="The Wirehead — technology, as it surfaced"
  description="Trending technology stories from Hacker News, Lobsters and independent feeds, read and written up automatically."
>
  <div class="front">
    {lead && (
      <article class="lead">
        <div class="kicker-row">
          <span class="kicker">{lead.section}</span>
          <span class="meta">{timeLine(lead.when)}</span>
        </div>
        <h1 class="lead-title">
          <a href={`/posts/${lead.slug}/`}>{lead.title}</a>
        </h1>
        <p class="lead-dek">{lead.dek}</p>
        {lead.excerpt && <p class="lead-excerpt">{lead.excerpt}</p>}
        <div class="tags">
          {lead.tags.map((t) => <a class="tag" href={`/topics/${t}/`}>{t}</a>)}
        </div>
      </article>
    )}

    {rail.length > 0 && (
      <aside class="rail">
        <h2 class="rail-head">Also today</h2>
        <ol class="rail-list">
          {rail.map((s) => (
            <li>
              <div>
                <h3 class="rail-title">
                  <a href={`/posts/${s.slug}/`}>{s.title}</a>
                </h3>
                <span class="meta">{s.section} &nbsp;·&nbsp; {timeLine(s.when)}</span>
              </div>
            </li>
          ))}
        </ol>
      </aside>
    )}

    {grid.length > 0 && (
      <>
        <div class="divider">
          <h2 class="section-head">More from the wire</h2>
        </div>
        <div class="grid">
          {grid.map((s) => (
            <article class="story">
              <div class="kicker-row">
                <span class="kicker">{s.section}</span>
                <span class="meta">{timeLine(s.when)}</span>
              </div>
              <h3 class="story-title">
                <a href={`/posts/${s.slug}/`}>{s.title}</a>
              </h3>
              <p class="story-dek">{s.dek}</p>
            </article>
          ))}
        </div>
      </>
    )}
  </div>
</Base>
