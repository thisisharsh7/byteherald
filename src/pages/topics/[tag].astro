---
import Base from "../../layouts/Base.astro";
import { topics, byTopic, timeLine } from "../../lib/posts";

export function getStaticPaths() {
  return topics().map(({ tag }) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const list = byTopic(tag);
const label = tag.replace(/-/g, " ");
const count = `${list.length} ${list.length === 1 ? "dispatch" : "dispatches"}`;
---

<Base
  title={`${label} — The Byte Herald`}
  description={`Every Byte Herald dispatch filed under ${label}.`}
  activeTopic={tag}
>
  <section style="padding-top:clamp(1.6rem,3.5vw,2.6rem)">
    <header class="index-head">
      <h1 class="index-title">{label}</h1>
      <span class="meta">{count}</span>
    </header>

    <ol class="index-list">
      {list.map((s) => (
        <li>
          <div class="kicker-row" style="margin-bottom:0.15rem">
            <span class="kicker">{s.section}</span>
            <span class="meta">{timeLine(s.when)}</span>
          </div>
          <h2 class="index-item-title">
            <a href={`/posts/${s.slug}/`}>{s.title}</a>
          </h2>
          <p class="index-item-dek">{s.dek}</p>
        </li>
      ))}
    </ol>

    <a class="backlink" href="/">&larr; Front page</a>
  </section>
</Base>
